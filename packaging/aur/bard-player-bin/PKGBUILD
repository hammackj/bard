# Maintainer: hammackj <172781+hammackj@users.noreply.github.com>
#
# Installs the prebuilt binary from the GitHub release. The AUR name is
# bard-player because "bard" (and "bard-bin") belong to an unrelated songbook
# tool; both install /usr/bin/bard, hence the conflict.

pkgname=bard-player-bin
pkgver=0.2.15
pkgrel=1
pkgdesc='Local music player for streamers, with Content ID-aware streamer mode and an OBS overlay'
arch=('x86_64')
url='https://github.com/hammackj/bard'
license=('MIT' 'OFL-1.1')
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libpipewire'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'opus'
)
optdepends=(
  'org.freedesktop.secrets: keep the OBS WebSocket password for auto-arm (KWallet, gnome-keyring, KeePassXC)'
)
provides=('bard-player')
conflicts=('bard-player' 'bard')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/bard-$pkgver-x86_64-linux.tar.gz"
        'bard.desktop')
sha256sums=('3d1aae88473155de88775b2ebcaf3fe159e26fce34d29a19946b13f6eaa9e83d'
            'd8dbefa520137acebb66d3073d434908e29bbae8b938ffcd518de0cbc229a479')

package() {
  cd "bard-$pkgver-x86_64-linux"

  install -Dm755 bard "$pkgdir/usr/bin/bard"
  install -Dm644 "$srcdir/bard.desktop" "$pkgdir/usr/share/applications/bard.desktop"

  install -Dm644 resources/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/bard.svg"
  local size
  for size in 16 22 24 32 48 64 128 256 512 1024; do
    install -Dm644 "resources/icons/icon-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/bard.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
