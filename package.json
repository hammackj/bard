{
  "name": "bard",
  "version": "0.1.2",
  "description": "Local music player for a curated library, with an OBS overlay",
  "main": "./out/main/index.js",
  "author": "hammackj <172781+hammackj@users.noreply.github.com>",
  "homepage": "https://github.com/hammackj/bard",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build:bundle": "npm run typecheck && electron-vite build",
    "build": "npm run build:bundle && node scripts/check-packaged.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build:bundle && electron-builder --dir",
    "build:win": "npm run build:bundle && electron-builder --win",
    "build:mac": "npm run build:bundle && electron-builder --mac",
    "build:linux": "npm run build:bundle && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.9",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.5.0",
    "music-metadata": "^11.14.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "productName": "Bard",
  "desktopName": "bard.desktop"
}
